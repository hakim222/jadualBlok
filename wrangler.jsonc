{
    "name": "jadualblok",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-10-08",
    "assets": {
      "directory": "./dist/",
      "not_found_handling": "single-page-application",
      "run_worker_first": ["/api/*"]
    },
    "d1_databases": [
      {
        "binding": "DB",                       // available in code as env.DB
        "database_name": "jadualblok",
        "database_id": "ec51656e-000f-4bb3-b521-76802ffcafe7"
      }
    ],
    // Live timetable sync: one SQLite-backed Durable Object (worker/schedule.ts).
    "durable_objects": {
      "bindings": [{ "name": "SCHEDULE", "class_name": "Schedule" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Schedule"] }],
    "observability": {
    "logs": {
      "enabled": false,
        "invocation_logs": true
      }
    }
  }